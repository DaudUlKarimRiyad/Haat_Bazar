# Haat_Bazar Environment Configuration Template

# Firebase Service Account Credentials File Path
FIREBASE_CREDENTIALS_PATH=haat-bazar-bd129-firebase-adminsdk-fbsvc-e196202e3a.json

# Optional: Firebase Credentials JSON string (useful for Vercel / serverless deployments)
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}

# Firestore Collection Name
FIRESTORE_COLLECTION=product_listings

# Database URL (Default: local SQLite; or PostgreSQL / Supabase URL)
DATABASE_URL=sqlite:///haat_bazar.db

# Server Configuration
PORT=8000
ENVIRONMENT=development
